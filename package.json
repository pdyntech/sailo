{
  "name": "noirxvelo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "provision": "tsx scripts/provision.ts",
    "lifecycle": "tsx scripts/lifecycle.ts",
    "default-demo": "tsx scripts/default-demo.ts",
    "check-mail": "tsx scripts/check-mail.ts",
    "test": "vitest run",
    "start": "npm run start -w @noirxvelo/server",
    "dev": "npm run dev -w @noirxvelo/server",
    "build": "tsx scripts/build-vercel.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noirx402/agent-sdk": "0.3.0",
    "@stellar/stellar-sdk": "16.4.1"
  }
}
