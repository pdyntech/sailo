# Copy to .env.local and fill in. Never commit real values.

# Velo (velo-build.dev dashboard)
VELO_API_KEY=
VELO_WEBHOOK_SECRET=

# Stellar Testnet demo wallets (generated by `npm run provision`)
TREASURY_PUBLIC=
TREASURY_SECRET=
SHIPOWNER_PUBLIC=
SHIPOWNER_SECRET=
LP_PUBLIC=
LP_SECRET=
DEBTOR_PUBLIC=
DEBTOR_SECRET=
AGENT_PUBLIC=
AGENT_SECRET=
RELAYER_PUBLIC=
RELAYER_SECRET=

# Agent model: a Gemini key (AIza…, aistudio.google.com/apikey) or a Claude key (platform.claude.com)
LLM_API_KEY=

# Public site URL (hosting provider)
APP_URL=

# Server (apps/server)
PORT=3000
# Velo checkout asset (handbook example uses "native")
VELO_CHECKOUT_ASSET=native
# Optional: AIS tick interval for the demo, ms
DEMO_TICK_MS=1800
# Optional: fake network delay in simulation mode, ms (default 450)
SIM_LATENCY_MS=
# Optional: file for the demo invoice store (empty = in memory)
NOIRXVELO_DATA_FILE=
# Tests only: 1 runs the live Testnet tests in `npm test`
LIVE=
# 1 = in-memory contracts (labelled simulated). Auto-on when wallet keys are missing.
SIMULATE_CHAIN=0
# Optional: model for the agent's PROCEED/HOLD judgment (default gemini-3.5-flash or claude-opus-5-5)
LLM_MODEL=
# Optional: gemini or anthropic; otherwise picked from the key
LLM_PROVIDER=

# Website accounts and portal (apps/server)
# Folder for accounts, sessions and portal invoices (sailo.json). Point at a persistent disk on the host.
DATA_DIR=
# Outgoing email for verification and password reset. Any SMTP provider works, e.g.
#   smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
#   smtps://<user>:<app-password>@smtp.gmail.com:465
# Leave empty in development: links are printed to the server log and shown in the UI (never in production).
# APP_URL (above) is the base for emailed links; set it in production.
SMTP_URL=
MAIL_FROM="Sailo <no-reply@yourdomain.com>"
# production turns off development email links in the UI
NODE_ENV=
# 1 = trust X-Forwarded-For (on by default when NODE_ENV=production)
TRUST_PROXY=
# Portal voyage length in ms (default 60000)
PORTAL_VOYAGE_MS=

# Shared store (required on Vercel): add Upstash from the Vercel Marketplace, which sets these two.
# UPSTASH_REDIS_REST_URL/_TOKEN or a plain REDIS_URL also work. Empty: local file (DATA_DIR).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional prefix for keys, if several deployments share one Redis
KV_PREFIX=
# Encrypts the portal's custodial Testnet wallet keys. Empty: derived from TREASURY_SECRET (then keep that unchanged).
# Setting it later is safe: wallets stored under the derived key stay readable.
WALLET_ENCRYPTION_KEY=
# Operator token for switching the live site between Testnet and simulation. Open /app?ops=<token> once in your browser.
# Unset on a deployed server: mode switching is off.
OPS_TOKEN=
# 0 = new portal invoices run in memory (simulated) instead of on Stellar Testnet
PORTAL_ONCHAIN=
